{
  "name": "dsh-zju-lecture-note",
  "version": "2.0.2",
  "description": "浙大智云课堂回放讲义插件（DeepSeek Harness 原生插件）：以「语音字幕 + 本地课件」为主链路，写完讲义自动排版同名 PDF；可选启用投影 PPT 截图抓取、填空式学习笔记与登录辅助工具；Cookie 只在本地内存中使用，不回显、不落盘",
  "license": "MIT",
  "author": "chenqianyu486",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenqianyu486-sys/dsh-zju-lecture-note.git"
  },
  "homepage": "https://github.com/chenqianyu486-sys/dsh-zju-lecture-note#readme",
  "bugs": {
    "url": "https://github.com/chenqianyu486-sys/dsh-zju-lecture-note/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "zju",
    "lecture",
    "transcript",
    "zhejiang-university",
    "mcp",
    "agent-skill",
    "privacy"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "cordis.patch.yml",
    "lib",
    "mcp_server.py",
    "zju_lecture/*.py",
    "zju_lecture/cacert.pem",
    "zju_lecture/prelude.typ",
    "zju_lecture/handout_prelude.typ",
    "skills/zju-lecture-summarizer",
    "skills/zju-lecture-summarizer.manifest.json",
    "skills/scholia-notes",
    "skills/scholia-notes.manifest.json",
    "icon.png",
    "LICENSE",
    "ATTRIBUTION.md",
    "SECURITY.md",
    "README.md",
    "CHANGELOG.md",
    "docs/technical.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "scripts": {
    "export:tools": "python tools/export_dsh_tools.py",
    "export:skill-manifest": "python tools/build_skill_manifest.py",
    "privacy": "python tools/privacy_scan.py",
    "test": "python -m unittest discover -s tests"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  }
}
